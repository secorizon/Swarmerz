{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Author: Laurent Gaffié, Secorizon.com. SPDX-License-Identifier: GPL-3.0-only. This file is part of Swarmerz, a terminal operations deck for independent model swarms.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {"type": "string"},
    "candidate_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "informational", "unknown"]
          },
          "assessment": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "provenance_class": {
            "type": "string",
            "enum": ["independent_discovery", "prior_artifact_corroboration", "derived"]
          },
          "validation_method": {
            "type": "string",
            "enum": ["executed_reproduction", "source_inspection", "reasoning_only"]
          },
          "reproduction": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "commands": {"type": "array", "items": {"type": "string"}},
              "observed_result": {"type": "string"},
              "artifact_refs": {"type": "array", "items": {"type": "string"}}
            },
            "required": ["commands", "observed_result", "artifact_refs"]
          }
        },
        "required": [
          "title",
          "severity",
          "assessment",
          "evidence",
          "provenance_class",
          "validation_method",
          "reproduction"
        ]
      }
    },
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number"}
  },
  "required": ["summary", "candidate_findings", "uncertainties", "confidence"]
}
